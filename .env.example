# Скопируйте в .env и заполните (файл .env не попадает в git).
TELEGRAM_BOT_TOKEN=123456789:AA...        # токен от @BotFather
TELEGRAM_CHAT_ID=@my_spanish_channel      # @username канала или числовой id (-100...)

# Необязательно:
TIMEZONE=Europe/Moscow                    # часовой пояс для лимита «постов в день»
POSTS_PER_DAY=1                           # сколько уроков можно публиковать в сутки
ENABLE_AUDIO=1                            # 0 — без озвучки
TTS_RATE=-10%                             # скорость речи диктора
# TTS_VOICE_F1=es-ES-ElviraNeural         # голоса озвучки: f1, f2, f3 — женские, m1, m2, m3 — мужские
# TTS_VOICE_M1=es-ES-AlvaroNeural
